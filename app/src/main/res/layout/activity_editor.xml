<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wooden_fon_new"
    tools:context=".EditorActivity">

    <include android:id="@+id/header"
        layout="@layout/activity_header"
        android:layout_height="wrap_content"
        android:layout_width="fill_parent"
        android:layout_alignParentTop="true"/>

    <RelativeLayout
        android:id="@+id/banner_placeholder"
        android:layout_below="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:padding="6dp"/>

    <com.yandex.mobile.ads.banner.BannerAdView
        android:id="@+id/banner"
        android:layout_below="@id/header"
        android:layout_width="match_parent"
        android:layout_height="50dp"/>

    <SurfaceView
        android:id="@+id/surfaceViewEditor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/banner_placeholder"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/quizzes_layout"
        android:layout_below="@id/surfaceViewEditor"
        android:layout_centerInParent="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_margin="5dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Начальная скорость змейки"
                android:textColor="@color/md_theme_onBackground"
                android:textSize="16sp"/>

            <EditText
                android:id="@+id/snake_speed"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="5"
                android:gravity="center"
                android:text="700"
                android:selectAllOnFocus="true"
                android:importantForAutofill="no"
                android:hint="700"
                android:textColor="@color/md_theme_onBackground"/>
        </LinearLayout>

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/save_level"
            android:tag="0"
            app:backgroundTint="@color/md_theme_seed"
            android:textColor="@color/md_theme_onPrimary"
            android:layout_margin="5dp"
            android:text="Сохранить"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/publish_level"
            android:tag="0"
            app:backgroundTint="@color/md_theme_seed"
            android:textColor="@color/md_theme_onPrimary"
            android:layout_margin="5dp"
            android:text="Опубликовать"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/clear_level"
            android:tag="0"
            app:backgroundTint="@color/md_theme_seed"
            android:textColor="@color/md_theme_onPrimary"
            android:layout_margin="5dp"
            android:text="Очистить всё"/>
    </LinearLayout>
</RelativeLayout>