<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".frontend.CustomLevelListActivity"
    android:background="@drawable/wooden_fon_new">

    <include android:id="@+id/header"
        layout="@layout/activity_header"
        android:layout_height="wrap_content"
        android:layout_width="fill_parent"
        android:layout_alignParentTop="true"/>

    <RelativeLayout
        android:id="@+id/banner_placeholder"
        android:layout_below="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:padding="6dp"/>

    <com.yandex.mobile.ads.banner.BannerAdView
        android:id="@+id/banner"
        android:layout_below="@id/header"
        android:layout_width="match_parent"
        android:layout_height="50dp"/>

    <TextView
        android:id="@+id/list_title"
        android:layout_below="@id/banner_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="Пользовательские уровни"
        android:textAlignment="center"
        android:textColor="@color/md_theme_onSecondaryContainer"
        android:textSize="24sp"
        android:textStyle="bold"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/level_list"
        android:layout_below="@id/list_title"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="12dp"
        android:clipToPadding="false"/>

    <TextView
        android:id="@+id/empty_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="Уровней пока нет"
        android:textColor="@color/md_theme_onSecondaryContainer"
        android:textSize="18sp"
        android:visibility="gone"/>
</RelativeLayout>